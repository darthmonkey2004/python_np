#!/bin/bash

echo "$#"
	

rmPycache() {
	dir=$(pwd)
	if [ -d "$dir/np/__pycache__" ]; then rm -rf "$dir/np/__pycache__"; fi
	if [ -d "$dir/np/core/__pycache__" ]; then rm -rf "$dir/np/core/__pycache__"; fi
	if [ -d "$dir/np/utils/__pycache__" ]; then rm -rf "$dir/np/utils/__pycache__"; fi
}

get_status() {
	cd "$HOME/usbhdbackup/dev/np_dev/python_np"
	git status
}

update() {
	commit_msg="$1"
	cd "$HOME/.local/lib/python3.8/site-packages/np"
	echo "Backing up current install..."
	ts=$(date +%s)
	tarfile="/home/monkey/usbhdbackup/storage/Software/Linux/np_backup/np_backup.$ts.tar.gz"
	tar -zcvf "$tarfile" "/home/monkey/usbhdbackup/storage/Software/Linux/python_np"
		if [ -f "$tarfile" ]; then
			echo "Backup successful!"
		else
			echo "Failed to create tarball backup! Aborting..."
			exit 1
		fi
	rm -rf "/home/monkey/usbhdbackup/storage/Software/Linux/python_np/np"
	echo "copying to storage..."
	cd ..
	cp -R np "/home/monkey/usbhdbackup/storage/Software/Linux/python_np/"
	rmPycache
	echo "removing old distutils junk..."
	if [ -d "/home/monkey/usbhdbackup/storage/Software/Linux/python_np/dist" ]; then
		rm -rf "/home/monkey/usbhdbackup/storage/Software/Linux/python_np/dist"
	fi
	if [ -d "/home/monkey/usbhdbackup/storage/Software/Linux/python_np/np.egg-info" ]; then
		rm -rf "/home/monkey/usbhdbackup/storage/Software/Linux/python_np/np.egg-info"
	fi
	if [ -d "/home/monkey/usbhdbackup/storage/Software/Linux/python_np/build" ]; then
		rm -rf "/home/monkey/usbhdbackup/storage/Software/Linux/python_np/build"
	fi
	cd "/home/monkey/usbhdbackup/storage/Software/Linux/python_np"
	echo "Removing pycache files..."
	rmPycache
	mkdir np/scripts
	cp "/home/monkey/usbhdbackup/storage/Software/Linux/np_dist_stuff/scripts/mkmedialist" np/scripts/mkmedialist
	if [ ! -f poster.png ]; then
		cp "/home/monkey/usbhdbackup/storage/Software/Linux/np_dist_stuff/poster.png" .
	fi
	if [ ! -f README ]; then
		cp "/home/monkey/usbhdbackup/storage/Software/Linux/np_dist_stuff/README" .
	fi
	if [ ! -f requirements.txt ]; then
		cp "/home/monkey/usbhdbackup/storage/Software/Linux/np_dist_stuff/requirements.txt" .
	fi
	if [ ! -f setup.py ]; then
		cp "/home/monkey/usbhdbackup/storage/Software/Linux/np_dist_stuff/setup.py" .
	fi
	np_remote=$(which np.remote)
	cp "$np_remote" np/scripts/np.remote
	if [ ! -f np/np ]; then
		np=$(which np)
		cp "$np" np/np
	fi
	echo "Running sdist..."
	python3 setup.py sdist
	cd ..
	np_dev="$HOME/usbhdbackup/dev/np_dev"
	echo "Updating git repo in np_dev..."
	cp -u -R python_np "$np_dev"
	cd "$np_dev/python_np"
	git add .
	git status
	token=$(cat ~/.bash_aliases | grep "git_token" | cut -d "'" -f 2)
	echo "Authentication token: Paste when prompted for password."
	echo "$token"
	read -p "Any key to update: " ak
	git commit -am "$commit_msg"
	git push
}
hasdash=$(echo "$1" | grep '-')
if [ -n "$hasdash" ]; then # if properly formatted arguments provided...
	while [[ $# -gt 0 ]] && [[ "$1" == ""* ]]; do
		arg="$1";
		shift
		case "$arg" in
			"--") break 2;;
			"--commit" )
				update "$1"; exit; shift;;
			"-c" )
				update "$1"; exit; shift;;
			"--commit"* )
				update "${arg#*=}"; exit;;
			"--status" )
				get_status;;
			"-s" )
				get_status;;
			"--status"* )
				get_status;;
			*) echo >&2 "Invalid option: $@"; exit 1;;
		esac
	done
else
	if [ -n "$1" ]; then # if no formatting but string is provided, assume commit msg.
		update "$1"
	else
		read -p "Enter commit message: " commit_msg # if se nada, axe 'em.
		update "$commit_msg"
		exit
	fi
fi
