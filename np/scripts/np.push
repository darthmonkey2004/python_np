#!/bin/bash

echo "$#"
	

rmPycache() {
	
	pc1="$HOME/.local/lib/python3.8/site-packages/np/__pycache__"
	pc2="$HOME/.local/lib/python3.8/site-packages/np/core/__pycache__"
	pc3="$HOME/.local/lib/python3.8/site-packages/np/utils/__pycache__"
	if [ -d "$pc1" ]; then rm -rf "$pc1"; fi
	if [ -d "$pc2" ]; then rm -rf "$pc2"; fi
	if [ -d "$pc3" ]; then rm -rf "$pc3"; fi
}

get_status() {
	cd "$HOME/usbhdbackup/dev/np_dev/python_np"
	git status
}

update() {
	commit_msg="$1"
	cd "$HOME/.local/lib/python3.8/site-packages/np"
	echo "Backing up current install..."
	ts=$(date +%s)
	tarfile="/var/dev/np_dev/python_np_backups/np_backup.$ts.tar.gz"
	tar -zcvf "$tarfile" "/var/dev/np_dev/python_np"
		if [ -f "$tarfile" ]; then
			echo "Backup successful!"
		else
			echo "Failed to create tarball backup! Aborting..."
			exit 1
		fi
	cd "$HOME/.local/lib/python3.8/site-packages"
	cp -R np "/var/dev/np_dev/python_np/"
	rmPycache
	echo "removing old distutils junk..."
	if [ -d "/var/dev/np_dev/python_np/dist" ]; then
		rm -rf "/var/dev/np_dev/python_np/dist"
	fi
	if [ -d "/var/dev/np_dev/python_np/np.egg-info" ]; then
		rm -rf "/var/dev/np_dev/python_np/np.egg-info"
	fi
	if [ -d "/var/dev/np_dev/python_np/build" ]; then
		rm -rf "/var/dev/np_dev/python_np/build"
	fi
	if [ ! -d "np/scripts" ]; then
		mkdir np/scripts
	fi
	cp $(which np) np/np
	cp $(which np.remote) np/scripts/np.remote
	echo "Running sdist..."
	cd "/var/dev/np_dev/python_np"
	python3 setup.py sdist
	git add .
	git status
	token=$(cat ~/.bash_aliases | grep "git_token" | cut -d "'" -f 2)
	echo "Authentication token: Paste when prompted for password."
	echo "$token"
	git commit -am "$commit_msg"
	git push
}
hasdash=$(echo "$1" | grep '-')
if [ -n "$hasdash" ]; then # if properly formatted arguments provided...
	while [[ $# -gt 0 ]] && [[ "$1" == ""* ]]; do
		arg="$1";
		shift
		case "$arg" in
			"--") break 2;;
			"--commit" )
				update "$1"; exit; shift;;
			"-c" )
				update "$1"; exit; shift;;
			"--commit"* )
				update "${arg#*=}"; exit;;
			"--status" )
				get_status;;
			"-s" )
				get_status;;
			"--status"* )
				get_status;;
			*) echo >&2 "Invalid option: $@"; exit 1;;
		esac
	done
else
	if [ -n "$1" ]; then # if no formatting but string is provided, assume commit msg.
		update "$1"
	else
		read -p "Enter commit message: " commit_msg # if se nada, axe 'em.
		update "$commit_msg"
		exit
	fi
fi
